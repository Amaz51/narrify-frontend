# ─── Narrify Frontend — copy to .env.local for dev, .env.production for prod ──

# Django backend URL (change to your production domain in prod)
NEXT_PUBLIC_DJANGO_API_URL=http://localhost:8002/api

# FastAPI backend URL (proxied via next.config.mjs rewrites)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000/api

# App
NEXT_PUBLIC_APP_NAME=Narrify
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (get from Google Cloud Console → APIs & Services → Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Features
NEXT_PUBLIC_ENABLE_VOICE_CLONING=true
NEXT_PUBLIC_MAX_FILE_SIZE_MB=50

# Set to false in production
NEXT_PUBLIC_DEBUG=false
